# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Ollama, vLLM, LM Studio…)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-6-luna
# OPENAI_TEMPERATURE=0.9

# ROOFTOP_ADDR=127.0.0.1:61613
# ROOFTOP_DATA=./data
# ROOFTOP_IMPORT=./ChatExport_Someone
# ROOFTOP_PASSWORD=change-me
# TZ=Europe/Berlin

# Optional: model that describes images and transcribes voice messages (must accept images + audio)
# OPENAI_MEDIA_MODEL=xiaomi/mimo-v2.6-flash

# Optional: answer share-link visitors from a Telegram group (see README)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=-1001234567890
